<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.buzz.agent-observability</string>
  <key>ProgramArguments</key>
  <array>
    <string>__BUZZ_EXECUTABLE__</string>
    <string>serve</string>
    <string>--database</string>
    <string>__BUZZ_DATA_DIR__/telemetry.sqlite3</string>
    <string>--token-file</string>
    <string>__BUZZ_CONFIG_DIR__/ingest-token</string>
    <string>--identity-salt-file</string>
    <string>__BUZZ_CONFIG_DIR__/identity-salt</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict><key>SuccessfulExit</key><false/></dict>
  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardOutPath</key>
  <string>__BUZZ_DATA_DIR__/collector.stdout.log</string>
  <key>StandardErrorPath</key>
  <string>__BUZZ_DATA_DIR__/collector.stderr.log</string>
</dict>
</plist>

[Unit]
Description=Buzz Agent Observability
Documentation=https://github.com/Bostonvex/buzz-agent-observability
After=network.target

[Service]
Type=simple
ExecStart=%h/.local/bin/buzz-observability serve
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.config/buzz-agent-observability %h/.local/share/buzz-agent-observability
RestrictAddressFamilies=AF_UNIX AF_INET
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=default.target
